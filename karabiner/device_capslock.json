{
  "title": "デバイス別Caps Lock設定",
  "rules": [
    {
      "description": "HHKB: Caps Lockはそのまま（音声入力用に残す）",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 33
                }
              ]
            }
          ],
          "from": {
            "key_code": "caps_lock"
          },
          "to": [
            {
              "key_code": "caps_lock"
            }
          ]
        }
      ]
    },
    {
      "description": "内蔵キーボード: Caps Lock → Control",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 33
                }
              ]
            }
          ],
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ]
        }
      ]
    },
    {
      "description": "内蔵キーボード: 両Shift同時押し → Caps Lock",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "vendor_id": 1278,
                  "product_id": 33
                }
              ]
            }
          ],
          "from": {
            "simultaneous": [
              {
                "key_code": "left_shift"
              },
              {
                "key_code": "right_shift"
              }
            ],
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "caps_lock"
            }
          ]
        }
      ]
    }
  ]
}
